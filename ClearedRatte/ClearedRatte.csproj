<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>ClearedRatte</AssemblyName>
    <Product>Deliberate landing guidance for Nuclear Option.</Product>
    <Version>1.0.0</Version>
    <LangVersion>latest</LangVersion>
    <RestoreAdditionalProjectSources>
      https://api.nuget.org/v3/index.json;
      https://nuget.bepinex.dev/v3/index.json;
      https://nuget.samboy.dev/v3/index.json
    </RestoreAdditionalProjectSources>
    <RootNamespace>ClearedRatte</RootNamespace>

    <!--Override with your own game dir: dotnet build -p:GameDirectory="..."-->
    <GameDirectory Condition="'$(GameDirectory)' == ''">Y:\SteamLibrary\steamapps\common\Nuclear Option</GameDirectory>

    <PluginDeploymentDirectory>$(GameDirectory)/BepInEx/plugins/ClearedRatte</PluginDeploymentDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" Version="1.*" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.*" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.*" />
    <PackageReference Include="UnityEngine.Modules" Version="2022.3.6" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDirectory)/NuclearOption_Data/Managed/Assembly-CSharp.dll</HintPath>
    </Reference>
    <!--Aircraft derives from Mirage's NetworkBehaviour.-->
    <Reference Include="Mirage">
      <HintPath>$(GameDirectory)/NuclearOption_Data/Managed/Mirage.dll</HintPath>
    </Reference>
    <!--The overlay's glideslope line and the map icons are uGUI Images.-->
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDirectory)/NuclearOption_Data/Managed/UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameDirectory)/NuclearOption_Data/Managed/Unity.TextMeshPro.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!--Copy the plugin into the local game install after every build.-->
  <Target Name="DeployClearedRatte" AfterTargets="Build" Condition="Exists('$(GameDirectory)')">
    <MakeDir Directories="$(PluginDeploymentDirectory)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll"
          DestinationFolder="$(PluginDeploymentDirectory)" />
    <Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb"
          DestinationFolder="$(PluginDeploymentDirectory)"
          Condition="Exists('$(OutputPath)$(AssemblyName).pdb')" />
  </Target>

</Project>
